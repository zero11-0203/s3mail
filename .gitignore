# Secrets and credentials: never commit (see AGENTS.md)
.env
.env.*
!.env.example
*.pem
*.key
.aws/
credentials.json

# Personal mail safety net: only synthetic fixtures under testdata/
*.eml
*.mbox
*.msg
!testdata/**/*.eml
!testdata/**/*.mbox

# Go
/bin/
/dist/
*.exe
*.test
*.out
coverage.*
go.work
go.work.sum
# Lambda build output (provided.al2023 "bootstrap" binaries and zips)
**/build/
*.zip

# Local search indexes and scratch databases
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# Terraform: keep .terraform.lock.hcl committed
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.json
plan.json
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# Private Terraform values stay local; commit *.tfvars.example only
*.tfvars
*.tfvars.json
!*.tfvars.example
# Backend settings name the account-specific state bucket
infra/backend.hcl

# Browser webmail (Node.js)
node_modules/
.next/

# Local Claude Code worktrees: nested checkouts that git add would stage
# as gitlinks
.claude/worktrees/
# Per-user Claude Code permissions
.claude/settings.local.json

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp
*~
