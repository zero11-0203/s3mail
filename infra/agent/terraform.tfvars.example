# Copy to terraform.tfvars (gitignored) and fill in from:
#   terraform -chdir=../main output -json agent
region           = "us-east-1"
jmap_session_url = "https://abc123.execute-api.us-east-1.amazonaws.com/v1/.well-known/jmap"
oauth_issuer     = "https://cognito-idp.us-east-1.amazonaws.com/us-east-1_example"
oauth_client_id  = "<agent client id>"
oauth_scopes     = ["s3mail/mail.read"]

# The pinned OpenRouter model (the default); its API key goes in the
# model_key_secret_arn secret, never here.
# ask_model = "openai/gpt-6.1-sol"

# Unset on the first apply; then the digest printed by make agent-image.
# image_digest = "sha256:<64 hex>"

# budget = { monthly_usd = 5, email = "owner@example.com" }
